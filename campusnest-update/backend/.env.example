# ---------- Database ----------
# USE_SQLITE=true  -> zero-setup local file DB (backend/campusnest.db)
# USE_SQLITE=false -> uses DATABASE_URL (PostgreSQL)
USE_SQLITE=true
SQLITE_PATH=campusnest.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusnest

# ---------- Auth ----------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# In DEBUG mode the DEMO_OTP is always accepted and real OTPs are printed to the console
DEBUG=true
DEMO_OTP=1234
OTP_EXPIRE_MINUTES=10

# ---------- App ----------
APP_NAME=CampusNest API
SEED_DEMO_DATA=true
# Comma-separated list of frontend origins ("*" allows all — fine for hackathon/demo)
ALLOWED_ORIGINS=http://localhost:5173,https://campus-nest.netlify.app

# ---------- Optional: Razorpay payments (leave blank to disable) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
